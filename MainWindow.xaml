<Window x:Class="RnxKrest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Крест" Icon="Assets/Krest.ico" Width="1080" Height="750" MinWidth="790" MinHeight="645"
        WindowStartupLocation="CenterScreen" FontFamily="pack://application:,,,/RnxKrest;component/Fonts/#Roboto, Segoe UI"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnKeyDown">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1420" Offset="0"/>
            <GradientStop Color="#111F31" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="30,25,30,23" MaxWidth="1250">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22" LastChildFill="True">
            <Button x:Name="HelpButton" DockPanel.Dock="Right" Style="{StaticResource Command}"
                    VerticalAlignment="Center" Content="Правила" Click="HelpClicked"/>
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" Background="#173A38" CornerRadius="13">
                    <Grid Width="25" Height="25" IsHitTestVisible="False">
                        <Rectangle Width="8" Height="25" RadiusX="2" RadiusY="2" Fill="{StaticResource Mint}"/>
                        <Rectangle Width="25" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Mint}"/>
                    </Grid>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Крест" FontSize="33" FontWeight="Bold" LineHeight="37"/>
                    <TextBlock Text="Логическая головоломка" Style="{StaticResource Label}" Margin="1,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="302"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="23,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Игровое поле" FontSize="20" FontWeight="SemiBold"/>
                    <Viewbox Grid.Row="1" Margin="0,8" StretchDirection="Both"
                             MaxWidth="472" MaxHeight="472">
                        <Grid x:Name="BoardHost"/>
                    </Viewbox>
                    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{StaticResource Muted}" FontSize="14" MinHeight="22"
                               automation:AutomationProperties.LiveSetting="Polite"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="19,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Целевой рисунок" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Повторите расположение фишек" Style="{StaticResource Label}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Viewbox Grid.Row="1" Margin="4,9" MaxWidth="196" MaxHeight="196">
                            <Grid x:Name="TargetHost" IsHitTestVisible="False"/>
                        </Viewbox>
                        <StackPanel Grid.Row="2">
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Foreground="{StaticResource Mint}"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Фишки на месте" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <Grid Height="6">
                                <Border Background="#27384D" CornerRadius="3"/>
                                <Border x:Name="ProgressFill" Background="{StaticResource Mint}" CornerRadius="3"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="19,14">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ходы" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="MoveText" Text="0" FontSize="27" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Время" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TimeText" Text="00:00" FontSize="27" FontWeight="SemiBold"/>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="UndoButton" Style="{StaticResource Command}" Content="Назад"
                                    AutomationProperties.Name="Отменить ход" Click="UndoClicked"
                                    ToolTip="Отменить ход (Ctrl+Z)"/>
                            <Button x:Name="HintButton" Grid.Column="2" Style="{StaticResource Command}"
                                    Content="Подсказка" Click="HintClicked" ToolTip="Подсказка (H)"/>
                        </Grid>
                        <Button x:Name="NewButton" Style="{StaticResource PrimaryCommand}"
                                Content="Новая игра" Click="NewClicked" ToolTip="Новая игра (Ctrl+N)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Label}"
                   Text="Ctrl+Z  Отменить ход     ·     H  Подсказка     ·     F1  Правила"
                   FontWeight="Normal" Margin="1,14,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>
